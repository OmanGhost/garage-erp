# =====================================================================
#  Garage ERP — environment configuration
#  Copy to .env, then run: php artisan key:generate
#  See docs/INSTALL.md and docs/DEPLOYMENT.md
# =====================================================================

APP_NAME="Garage ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp.example.om

# Arabic first; users can switch per account (ar / en)
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Asia/Muscat

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

# ---------------------------------------------------------------- database
# MySQL 8+ (or MariaDB 10.6+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=garage_erp
DB_USERNAME=garage_erp
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ---------------------------------------------------------------- sessions
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ---------------------------------------------------------------- cache & queue
# Recommended in production: redis for cache and queue.
# Shared hosting (cPanel) without Redis: CACHE_STORE=database, QUEUE_CONNECTION=database
CACHE_STORE=redis
CACHE_PREFIX=garage_erp_
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local
# maximum upload size per file (KB)
UPLOAD_MAX_KB=10240

# ---------------------------------------------------------------- real-time (Laravel Reverb, self-hosted, free)
# Use BROADCAST_CONNECTION=log (or null) to disable live updates.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=garage-erp
REVERB_APP_KEY=change-me-key
REVERB_APP_SECRET=change-me-secret
# public host/port the browser connects to (behind Nginx: your domain + 443 + https)
REVERB_HOST=erp.example.om
REVERB_PORT=443
REVERB_SCHEME=https
# where the Reverb server process listens
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# ---------------------------------------------------------------- mail (SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.om
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.om"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------- API (Sanctum)
SANCTUM_STATEFUL_DOMAINS=erp.example.om
SANCTUM_TOKEN_PREFIX=gerp_

# ---------------------------------------------------------------- ERP defaults (Oman)
ERP_CURRENCY=OMR
ERP_CURRENCY_DECIMALS=3
ERP_DEFAULT_VAT=5
ERP_AUDIT=true

# ---------------------------------------------------------------- backups (php artisan erp:backup, scheduled daily 02:00)
# Full paths if mysqldump/mysql are not on PATH (e.g. C:/xampp/mysql/bin/mysqldump.exe)
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql
BACKUP_KEEP_DAYS=14

# ---------------------------------------------------------------- SIEM (optional syslog forwarding of security events)
SIEM_ENABLED=false
SIEM_HOST=127.0.0.1
SIEM_PORT=514
SIEM_IDENT=garage-erp

# SMS / WhatsApp / payment gateway / VIN decoder credentials are configured
# per company from the UI (Settings → Integrations) and stored encrypted.
